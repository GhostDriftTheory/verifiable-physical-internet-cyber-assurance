import Std

/-!
Public, fixed-scope VPI reference model. No external Lean libraries.

There are three deliberately separate claims:
* an admission function on validated observations (unbounded natural epochs/times);
* immutable local terminal outcomes and one B -> C failover, for arbitrary trace length;
* concrete raw-input comparisons generated by validate.py.

The model does NOT prove HTTP, SQLite, cryptography, hidden predicates, clock honesty,
Byzantine safety, physical exactly-once effects, or Python/Lean semantic refinement.
Source admission linearizes at grant issuance; it is not retroactively invalidated
by a source revocation that occurs after issuance. Receiver checks are local.
The repository report, not the presence of this file, records whether Lean ran.
-/
set_option autoImplicit false
set_option warningAsError true

namespace VpiAssurance

structure GateInput where
  enabled : Bool
  eligible : Bool
  peerEnabled : Bool
  revision : Nat
  permitRevision : Nat
  peerRevision : Nat
  permitPeerRevision : Nat
  requestIssued : Nat
  permitIssued : Nat
  now : Nat
  permitExpires : Nat
  requestExpires : Nat
  sourceVerified : Bool
  sourceIssued : Nat
  sourceExpires : Nat
  deriving Repr, DecidableEq

def receiverOK (g : GateInput) : Prop :=
  g.enabled = true ∧ g.peerEnabled = true ∧
  g.revision = g.permitRevision ∧ g.peerRevision = g.permitPeerRevision ∧
  g.requestIssued ≤ g.permitIssued ∧ g.permitIssued ≤ g.now ∧
  g.now < g.permitExpires ∧ g.permitExpires ≤ g.requestExpires

def sourceOK (g : GateInput) : Prop :=
  g.eligible = true ∧ g.sourceVerified = true ∧
  g.sourceIssued ≤ g.now ∧ g.now < g.sourceExpires

instance (g : GateInput) : Decidable (receiverOK g) := by
  unfold receiverOK
  infer_instance

instance (g : GateInput) : Decidable (sourceOK g) := by
  unfold sourceOK
  infer_instance

/-- Same priority as assurance.py: 0=REJECT, 1=HOLD, 2=ADMIT. -/
def gateDecision (g : GateInput) : Nat :=
  if ¬ receiverOK g then 0 else if ¬ sourceOK g then 1 else 2

theorem decision_admit_iff (g : GateInput) :
    gateDecision g = 2 ↔ receiverOK g ∧ sourceOK g := by
  by_cases hr : receiverOK g <;> by_cases hs : sourceOK g <;>
    simp [gateDecision, hr, hs]

theorem decision_reject_iff (g : GateInput) :
    gateDecision g = 0 ↔ ¬ receiverOK g := by
  by_cases hr : receiverOK g <;> by_cases hs : sourceOK g <;>
    simp [gateDecision, hr, hs]

theorem decision_hold_iff (g : GateInput) :
    gateDecision g = 1 ↔ receiverOK g ∧ ¬ sourceOK g := by
  by_cases hr : receiverOK g <;> by_cases hs : sourceOK g <;>
    simp [gateDecision, hr, hs]

theorem decision_range (g : GateInput) :
    gateDecision g = 0 ∨ gateDecision g = 1 ∨ gateDecision g = 2 := by
  by_cases hr : receiverOK g <;> by_cases hs : sourceOK g <;>
    simp [gateDecision, hr, hs]

theorem admitted_has_matching_versions (g : GateInput) (h : gateDecision g = 2) :
    g.revision = g.permitRevision ∧ g.peerRevision = g.permitPeerRevision := by
  have hr := ((decision_admit_iff g).mp h).1
  exact ⟨hr.2.2.1, hr.2.2.2.1⟩

theorem admitted_receiver_enabled (g : GateInput) (h : gateDecision g = 2) :
    g.enabled = true ∧ g.peerEnabled = true := by
  have hr := ((decision_admit_iff g).mp h).1
  exact ⟨hr.1, hr.2.1⟩

theorem admitted_has_fresh_source_witness (g : GateInput) (h : gateDecision g = 2) :
    g.sourceVerified = true ∧ g.sourceIssued ≤ g.now ∧ g.now < g.sourceExpires := by
  exact ((decision_admit_iff g).mp h).2.2

theorem admitted_permit_not_expired (g : GateInput) (h : gateDecision g = 2) :
    g.now < g.permitExpires := by
  exact ((decision_admit_iff g).mp h).1.2.2.2.2.2.2.1

theorem revoked_receiver_rejects (g : GateInput) (h : g.enabled = false) :
    gateDecision g = 0 := by
  apply (decision_reject_iff g).mpr
  simp [receiverOK, h]

theorem disabled_peer_rejects (g : GateInput) (h : g.peerEnabled = false) :
    gateDecision g = 0 := by
  apply (decision_reject_iff g).mpr
  simp [receiverOK, h]

theorem changed_receiver_version_rejects (g : GateInput)
    (h : g.revision ≠ g.permitRevision) : gateDecision g = 0 := by
  apply (decision_reject_iff g).mpr
  intro hr
  exact h hr.2.2.1

theorem absent_source_witness_holds (g : GateInput)
    (hr : receiverOK g) (h : g.sourceVerified = false) : gateDecision g = 1 := by
  apply (decision_hold_iff g).mpr
  exact ⟨hr, by simp [sourceOK, h]⟩

theorem expired_source_witness_cannot_admit (g : GateInput)
    (h : g.sourceExpires ≤ g.now) : gateDecision g ≠ 2 := by
  intro ha
  have hs := (admitted_has_fresh_source_witness g ha).2.2
  omega

structure SourceInput where
  enabled : Bool
  eligible : Bool
  peerEnabled : Bool
  dispatched : Bool
  matchesCurrentRequest : Bool
  revision : Nat
  requestRevision : Nat
  peerRevision : Nat
  requestPeerRevision : Nat
  now : Nat
  requestExpires : Nat
  deriving Repr, DecidableEq

/-- Observations additionally require authentic challenge/request/permit bindings. -/
def sourceAllows (s : SourceInput) : Prop :=
  s.enabled = true ∧ s.eligible = true ∧ s.peerEnabled = true ∧
  s.dispatched = true ∧ s.matchesCurrentRequest = true ∧
  s.revision = s.requestRevision ∧ s.peerRevision = s.requestPeerRevision ∧
  s.now < s.requestExpires

instance (s : SourceInput) : Decidable (sourceAllows s) := by
  unfold sourceAllows
  infer_instance

theorem source_requires_dispatch (s : SourceInput) (h : sourceAllows s) :
    s.dispatched = true := by exact h.2.2.2.1

theorem source_requires_current_versions (s : SourceInput) (h : sourceAllows s) :
    s.revision = s.requestRevision ∧ s.peerRevision = s.requestPeerRevision := by
  exact ⟨h.2.2.2.2.2.1, h.2.2.2.2.2.2.1⟩

theorem source_revoked_cannot_issue (s : SourceInput) (h : s.enabled = false) :
    ¬ sourceAllows s := by simp [sourceAllows, h]

theorem prepared_only_cannot_issue (s : SourceInput) (h : s.dispatched = false) :
    ¬ sourceAllows s := by simp [sourceAllows, h]

inductive Terminal where
  | empty | cancelled | committed
  deriving Repr, DecidableEq

def commitTerminal : Terminal → Terminal
  | .empty => .committed
  | x => x

def cancelTerminal : Terminal → Terminal
  | .empty => .cancelled
  | x => x

theorem commit_idempotent (t : Terminal) :
    commitTerminal (commitTerminal t) = commitTerminal t := by cases t <;> rfl

theorem cancel_idempotent (t : Terminal) :
    cancelTerminal (cancelTerminal t) = cancelTerminal t := by cases t <;> rfl

theorem cancellation_fences_late_commit :
    commitTerminal .cancelled = .cancelled := rfl

theorem commit_survives_cancellation :
    cancelTerminal .committed = .committed := rfl

inductive Destination where
  | B | C
  deriving Repr, DecidableEq

structure State where
  route : Destination
  b : Terminal
  c : Terminal
  deriving Repr, DecidableEq

inductive Event where
  | commitB | commitC | cancelB | cancelC | switchToC | deny | lostReply | restart
  deriving Repr, DecidableEq

/-- Terminal updates are atomic. No-reply events cannot fabricate a cancellation. -/
def step (s : State) (e : Event) : State :=
  match e with
  | .commitB => {s with b := commitTerminal s.b}
  | .commitC => if s.route = .C then {s with c := commitTerminal s.c} else s
  | .cancelB => {s with b := cancelTerminal s.b}
  | .cancelC => {s with c := cancelTerminal s.c}
  | .switchToC => if s.b = .cancelled then {s with route := .C} else s
  | .deny | .lostReply | .restart => s

/-- Concrete admission results only select a commit event or a no-effect event. -/
def commitEvent (d : Destination) (g : GateInput) : Event :=
  if gateDecision g = 2 then
    match d with | .B => .commitB | .C => .commitC
  else .deny

def invariant (s : State) : Prop :=
  ¬ (s.b = .committed ∧ s.c = .committed) ∧
  (s.route = .B → s.c ≠ .committed) ∧
  (s.route = .C → s.b = .cancelled)

instance (s : State) : Decidable (invariant s) := by
  unfold invariant
  infer_instance

def initial : State := ⟨.B, .empty, .empty⟩

theorem initial_invariant : invariant initial := by decide

/-- Complete finite case split on a single transition; no unproved oracle. -/
theorem step_preserves_invariant (s : State) (e : Event) :
    invariant s → invariant (step s e) := by
  cases s with
  | mk r b c =>
    cases r <;> cases b <;> cases c <;> cases e <;> decide

def run (s : State) : List Event → State
  | [] => s
  | e :: es => run (step s e) es

theorem arbitrary_trace_invariant (es : List Event) (s : State)
    (h : invariant s) : invariant (run s es) := by
  induction es generalizing s with
  | nil => exact h
  | cons e es ih =>
    exact ih (step s e) (step_preserves_invariant s e h)

theorem arbitrary_trace_at_most_one_effect (es : List Event) :
    ¬ ((run initial es).b = .committed ∧ (run initial es).c = .committed) := by
  exact (arbitrary_trace_invariant es initial initial_invariant).1

theorem switch_requires_cancelled_old_destination (s : State)
    (h : s.route = .B) (h' : (step s .switchToC).route = .C) :
    s.b = .cancelled := by
  by_cases hc : s.b = .cancelled
  · exact hc
  · simp [step, hc, h] at h'

theorem lost_reply_is_not_cancellation (s : State) :
    step s .lostReply = s := rfl

theorem restart_preserves_terminal_state (s : State) :
    (step s .restart).b = s.b ∧ (step s .restart).c = s.c := by exact ⟨rfl, rfl⟩

theorem denied_gate_cannot_change_state (s : State) (d : Destination) (g : GateInput)
    (h : gateDecision g ≠ 2) : step s (commitEvent d g) = s := by
  simp [commitEvent, h, step]

end VpiAssurance
